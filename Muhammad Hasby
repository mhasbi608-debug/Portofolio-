<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Muhammad Hasby — Portofolio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #080808;
  --surface: #101010;
  --surface2: #161616;
  --border: #1e1e1e;
  --border2: #2a2a2a;
  --accent: #00e5b0;
  --accent-dim: rgba(0,229,176,0.07);
  --accent-dim2: rgba(0,229,176,0.12);
  --text: #e8e8e8;
  --muted: #555;
  --muted2: #888;
  --white: #ffffff;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;line-height:1.6;overflow-x:hidden}
::-webkit-scrollbar{width:3px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:var(--accent)}

/* NAV */
nav{position:fixed;top:0;width:100%;z-index:200;background:rgba(8,8,8,0.92);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 5%;height:58px}
.nav-logo{font-family:'Bebas Neue',sans-serif;font-size:1.4rem;letter-spacing:.12em;color:var(--accent)}
.nav-links{display:flex;gap:2.2rem;list-style:none}
.nav-links a{color:var(--muted);text-decoration:none;font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;transition:color .2s}
.nav-links a:hover,.nav-links a.active{color:var(--accent)}

/* HERO */
#hero{min-height:100vh;display:flex;flex-direction:column;justify-content:center;padding:110px 5% 80px;position:relative;overflow:hidden}
.hero-grid-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(0,229,176,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(0,229,176,.025) 1px,transparent 1px);background-size:55px 55px;pointer-events:none;mask-image:radial-gradient(ellipse at 70% 50%,transparent 25%,black 65%)}
.hero-glow{position:absolute;top:40%;left:55%;transform:translate(-50%,-50%);width:650px;height:650px;background:radial-gradient(circle,rgba(0,229,176,.06) 0%,transparent 60%);pointer-events:none}
.hero-tag{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(0,229,176,.35);color:var(--accent);font-size:.67rem;letter-spacing:.18em;text-transform:uppercase;padding:6px 14px;border-radius:2px;margin-bottom:1.6rem;width:fit-content}
.hero-dot{width:6px;height:6px;border-radius:50%;background:var(--accent);animation:pulse 2s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.3;transform:scale(.8)}}
.hero-name{font-family:'Bebas Neue',sans-serif;font-size:clamp(4rem,10.5vw,9.5rem);line-height:.88;letter-spacing:.01em;color:var(--white);margin-bottom:1.6rem}
.hero-name .ac{color:var(--accent)}
.hero-sub{max-width:520px;font-size:.92rem;color:#666;line-height:1.8;margin-bottom:2.5rem}
.hero-sub strong{color:#999}
.btns{display:flex;gap:.9rem;flex-wrap:wrap}
.btn-p{background:var(--accent);color:#080808;padding:12px 28px;border:none;border-radius:2px;font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:7px;transition:all .2s}
.btn-p:hover{background:#fff;transform:translateY(-2px)}
.btn-o{background:transparent;color:var(--text);padding:12px 28px;border:1px solid var(--border2);border-radius:2px;font-size:.72rem;font-weight:500;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:7px;transition:all .2s}
.btn-o:hover{border-color:var(--accent);color:var(--accent)}
.hero-stats{display:flex;gap:2.5rem;flex-wrap:wrap;margin-top:3.5rem;padding-top:2rem;border-top:1px solid var(--border)}
.stat-n{font-family:'Bebas Neue',sans-serif;font-size:2.6rem;color:var(--accent);line-height:1}
.stat-l{font-size:.65rem;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;margin-top:2px}

/* SECTION COMMON */
.s-wrap{max-width:1100px;margin:0 auto;padding:6rem 5%}
.s-tag{font-size:.66rem;letter-spacing:.2em;text-transform:uppercase;color:var(--accent);margin-bottom:.4rem}
.s-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(2.5rem,5vw,4.2rem);line-height:.92;color:var(--white);margin-bottom:2.8rem}

/* ABOUT */
.about-layout{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:start}
.photo-gallery{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.photo-main{grid-column:1/-1;height:320px;background:var(--surface2);border:1px solid var(--border);border-radius:4px;overflow:hidden;position:relative}
.photo-main img{width:100%;height:100%;object-fit:cover;object-position:top center;transition:transform .4s}
.photo-main:hover img{transform:scale(1.03)}
.photo-sm{height:160px;background:var(--surface2);border:1px solid var(--border);border-radius:4px;overflow:hidden;position:relative}
.photo-sm img{width:100%;height:100%;object-fit:cover;object-position:top center;transition:transform .4s}
.photo-sm:hover img{transform:scale(1.05)}
.photo-placeholder{width:100%;height:100%;background:linear-gradient(135deg,#0d1f1b,var(--surface2));display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:3.5rem;color:var(--accent)}
.about-bio{font-size:.9rem;color:#777;line-height:1.9;margin-bottom:1.6rem}
.about-bio strong{color:var(--white)}
.about-bio .hl{color:var(--accent);font-weight:600}
.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:.7rem}
.info-box{background:var(--surface);border:1px solid var(--border);padding:.85rem 1rem;border-radius:3px}
.info-lbl{font-size:.6rem;color:var(--muted);text-transform:uppercase;letter-spacing:.12em;margin-bottom:3px}
.info-val{font-size:.82rem;color:var(--text);font-weight:500}

/* EXPERIENCE */
#experience{border-top:1px solid var(--border)}
.exp-card{background:var(--surface);border:1px solid var(--border);border-left:3px solid var(--accent);border-radius:4px;overflow:hidden;margin-bottom:1.5rem}
.exp-header{padding:2rem 2.2rem 1.5rem;border-bottom:1px solid var(--border)}
.exp-top{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:.5rem;margin-bottom:.3rem}
.exp-title{font-size:1.05rem;font-weight:700;color:var(--white)}
.exp-period{font-size:.7rem;color:var(--accent);background:var(--accent-dim2);padding:4px 10px;border-radius:2px;letter-spacing:.04em;white-space:nowrap}
.exp-org{font-size:.8rem;color:#555;margin-bottom:.9rem}
.exp-badges{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:1rem}
.badge{font-size:.6rem;text-transform:uppercase;letter-spacing:.1em;border:1px solid rgba(0,229,176,.35);color:var(--accent);padding:3px 9px;border-radius:2px}
.exp-points{list-style:none;display:flex;flex-direction:column;gap:5px}
.exp-points li{font-size:.83rem;color:#6a6a6a;padding-left:1.1rem;position:relative}
.exp-points li::before{content:'→';position:absolute;left:0;color:var(--accent);font-size:.7rem;top:3px}

/* PROGRAM GRID */
.program-section{padding:1.8rem 2.2rem}
.prog-header{font-size:.64rem;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);display:flex;align-items:center;gap:10px;margin-bottom:1.2rem}
.prog-header::after{content:'';flex:1;height:1px;background:var(--border2)}
.programs-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.9rem}
.prog-card{background:var(--surface2);border:1px solid var(--border2);border-radius:4px;overflow:hidden;transition:all .2s;cursor:pointer;text-decoration:none;display:block}
.prog-card:hover{border-color:rgba(0,229,176,.3);transform:translateY(-3px)}
.prog-img{width:100%;height:140px;object-fit:cover;display:block;background:var(--bg)}
.prog-img-ph{width:100%;height:140px;background:linear-gradient(135deg,#0a1a15,var(--surface2));display:flex;align-items:center;justify-content:center;font-size:2rem}
.prog-body{padding:.85rem .9rem}
.prog-tag{font-size:.58rem;text-transform:uppercase;letter-spacing:.1em;color:var(--accent);margin-bottom:.3rem}
.prog-name{font-size:.82rem;font-weight:600;color:var(--white);line-height:1.3;margin-bottom:.25rem}
.prog-desc{font-size:.73rem;color:#555;line-height:1.5}

/* REPORT CARD */
.report-card{margin:0 2.2rem 2rem;background:var(--surface2);border:1px solid var(--border2);border-radius:4px;padding:1.2rem 1.4rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap}
.report-info .report-lbl{font-size:.6rem;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin-bottom:3px}
.report-info .report-name{font-size:.9rem;font-weight:600;color:var(--white)}
.report-info .report-sub{font-size:.75rem;color:#555}
.btn-report{background:var(--accent);color:#080808;padding:9px 18px;border-radius:2px;font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;white-space:nowrap;transition:all .2s;display:inline-flex;align-items:center;gap:6px}
.btn-report:hover{background:#fff}

/* SKILLS */
#skills{background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.skills-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}
.skill-group{background:var(--bg);border:1px solid var(--border);padding:1.4rem;border-radius:4px}
.skill-g-title{font-size:.63rem;text-transform:uppercase;letter-spacing:.15em;color:var(--accent);margin-bottom:.8rem;display:flex;align-items:center;gap:8px}
.skill-g-title span{font-size:1rem}
.skill-tags{display:flex;flex-wrap:wrap;gap:6px}
.stag{background:var(--surface2);border:1px solid var(--border);color:#888;font-size:.74rem;padding:5px 11px;border-radius:2px;transition:all .2s}
.stag:hover{border-color:var(--accent);color:var(--accent)}

/* CERTIFICATES */
#certificates{border-top:1px solid var(--border)}
.certs-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}
.cert-card{background:var(--surface);border:1px solid var(--border);border-radius:4px;overflow:hidden;text-decoration:none;display:block;transition:all .25s;position:relative}
.cert-card:hover{border-color:rgba(0,229,176,.3);transform:translateY(-4px);box-shadow:0 14px 40px rgba(0,0,0,.4)}
.cert-img-wrap{width:100%;height:180px;background:var(--surface2);overflow:hidden;position:relative}
.cert-img-wrap img{width:100%;height:100%;object-fit:cover;object-position:top center;transition:transform .3s}
.cert-card:hover .cert-img-wrap img{transform:scale(1.04)}
.cert-img-ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:2.5rem;background:linear-gradient(135deg,#0a1a15,var(--surface2))}
.cert-label{padding:1rem 1.1rem}
.cert-year{font-size:.6rem;color:var(--accent);letter-spacing:.15em;text-transform:uppercase;margin-bottom:.3rem}
.cert-name{font-size:.82rem;font-weight:600;color:var(--white);line-height:1.35;margin-bottom:.2rem}
.cert-issuer{font-size:.71rem;color:#555}
.cert-arrow{position:absolute;top:.8rem;right:.8rem;font-size:.75rem;color:var(--border2);transition:color .2s}
.cert-card:hover .cert-arrow{color:var(--accent)}

/* CONTACT */
#contact{border-top:1px solid var(--border)}
.contact-box{background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:3.5rem}
.contact-intro{font-size:.9rem;color:#666;margin-top:-.8rem;margin-bottom:2.2rem}
.contact-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}
.c-item{background:var(--surface2);border:1px solid var(--border);padding:1.2rem;border-radius:3px;text-decoration:none;transition:all .2s;display:block}
.c-item:hover{border-color:var(--accent)}
.c-lbl{font-size:.6rem;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;margin-bottom:4px}
.c-val{font-size:.84rem;color:var(--text)}
.c-val.ac{color:var(--accent)}

/* FOOTER */
footer{border-top:1px solid var(--border);padding:2rem 5%;text-align:center;font-size:.7rem;color:var(--muted)}
footer span{color:var(--accent)}

/* LIGHTBOX */
.lightbox{display:none;position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:999;align-items:center;justify-content:center;backdrop-filter:blur(8px)}
.lightbox.open{display:flex}
.lightbox img{max-width:88vw;max-height:88vh;object-fit:contain;border-radius:4px;border:1px solid var(--border2)}
.lb-close{position:absolute;top:1.5rem;right:2rem;font-size:2rem;color:var(--muted2);cursor:pointer;transition:color .2s;line-height:1;background:none;border:none}
.lb-close:hover{color:var(--white)}

/* ANIMATIONS */
.fade-up{opacity:0;transform:translateY(24px);transition:opacity .6s ease,transform .6s ease}
.fade-up.visible{opacity:1;transform:none}
.fade-up:nth-child(2){transition-delay:.1s}
.fade-up:nth-child(3){transition-delay:.2s}
.fade-up:nth-child(4){transition-delay:.3s}

/* RESPONSIVE */
@media(max-width:900px){
  .about-layout{grid-template-columns:1fr}
  .programs-grid{grid-template-columns:1fr 1fr}
  .certs-grid{grid-template-columns:1fr 1fr}
  .skills-grid{grid-template-columns:1fr}
}
@media(max-width:600px){
  .nav-links{display:none}
  .photo-gallery{grid-template-columns:1fr}
  .photo-main{grid-column:auto}
  .programs-grid{grid-template-columns:1fr}
  .certs-grid{grid-template-columns:1fr}
  .contact-grid{grid-template-columns:1fr}
  .hero-stats{gap:1.5rem}
}
</style>
</head>
